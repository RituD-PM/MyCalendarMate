    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.request }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are extracting a meeting recap from notes/transcript the user provides. Produce:\n- meetingTitle: best-guess title of the meeting.\n- attendeeEmails: any email addresses mentioned (array, empty if none).\n- emailBody: a ready-to-send recap email, written in plain text, containing (a) a 3-5 sentence neutral summary of what was discussed/decided, then (b) a clearly labeled 'Action Items' section listing each item as '- [Owner] Task (Due: date or \"unspecified\")'. Infer owners from names/emails mentioned near each task; use \"Unassigned\" if truly unclear. If no action items were mentioned, say so in that section instead of inventing any.\nIf the input has no clear meeting content, still return your best-effort structure rather than refusing."
        }
      },
      "id": "487f382f-3117-4103-8383-8fd714c33c08",
      "name": "Extract Recap",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -688,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "gpt-5-mini"
        },
        "options": {}
      },
      "id": "d56b8c16-3d28-4870-84dc-0f43f5aa6250",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -736,
        304
      ],
      "credentials": {
        "openAiApi": {
          "id": "F8dWILAPQbnLOYol",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"meetingTitle\": { \"type\": \"string\" },\n    \"attendeeEmails\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"emailBody\": { \"type\": \"string\" },\n    \"actionItemCount\": { \"type\": \"number\" }\n  },\n  \"required\": [\"meetingTitle\", \"attendeeEmails\", \"emailBody\", \"actionItemCount\"]\n}"
      },
      "id": "665d4e1b-a877-4925-b198-6d3d91400edb",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -480,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output.attendeeEmails.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "920626a1-33fd-48fa-a846-dde43bbb314c",
      "name": "Attendees Known?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        112
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.output.attendeeEmails.join(',') }}",
        "subject": "=Recap: {{ $json.output.meetingTitle }}",
        "message": "={{ $json.output.emailBody }}",
        "options": {}
      },
      "id": "fbce4cd7-5663-4e12-9c67-ca3800b28bde",
      "name": "Email Recap to Attendees",
